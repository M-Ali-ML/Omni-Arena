{
  "name": "@omni-arena/react",
  "version": "0.1.0",
  "description": "Headless React hooks for OmniArena: blind side-by-side LLM comparisons, voting, and the Bradley-Terry leaderboard.",
  "license": "MIT",
  "keywords": [
    "llm",
    "arena",
    "evaluation",
    "leaderboard",
    "bradley-terry",
    "react",
    "hooks",
    "headless",
    "streaming",
    "sse",
    "ai"
  ],
  "homepage": "https://github.com/M-Ali-ML/Omni-Arena/tree/main/packages/react-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Ali-ML/Omni-Arena.git",
    "directory": "packages/react-sdk"
  },
  "bugs": {
    "url": "https://github.com/M-Ali-ML/Omni-Arena/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
