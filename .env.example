DATABASE_URL=postgres://omni_arena:omni_arena@localhost:5432/omni_arena
MATCHUP_TOKEN_SECRET=replace-with-a-long-random-secret
PORT=3001
WEB_ORIGIN=http://localhost:5173
HARNESS_VERSION=v1

# Create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI, or an OpenAI-compatible endpoint when OPENAI_BASE_URL is set.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local providers. Ollama is registered at this default even when omitted.
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=
VLLM_API_KEY=

# Optional host-owned OpenAI-compatible proxy (provider key stays in the host).
HOST_PROXY_URL=
HOST_PROXY_TOKEN=
