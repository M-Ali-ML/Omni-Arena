# Copy to .env and fill in. Loaded from the repo root by the server
# (server/src/env.ts) and by docker compose. Every variable the server and the
# rating worker read is listed below; blanks fall back to the documented
# defaults.

# --- Core server -------------------------------------------------------------

# Postgres connection string.
#   - npm dev path (server on the host):   host is localhost
#   - docker compose path (app container): the `app` service overrides this to
#     the compose hostname `postgres`, so the value below only needs to be right
#     for the local dev path.
DATABASE_URL=postgres://omni_arena:omni_arena@localhost:5432/omni_arena

# HMAC secret for matchup tokens (min 16 chars). REQUIRED in production; an
# insecure development default is used with a warning if unset.
MATCHUP_TOKEN_SECRET=replace-with-a-long-random-secret

# Port the app (API + co-served web UI) listens on. In docker compose this is
# also the published host port.
PORT=3001

# Allowed CORS origin. Only matters when the web app is served from a different
# origin than the API; the single-container Docker build serves both same-origin.
WEB_ORIGIN=http://localhost:5173

# Version label persisted on every matchup.
HARNESS_VERSION=v1

# Matchmaking strategy: `smart` (default; prioritises under-sampled and
# high-variance model pairs) or `random` (uniform sampling).
MATCHMAKER=smart

# When the arena engages. `always` (default) runs a blind A/B matchup on every
# request — today's behavior. `manual` serves a single model by default and only
# runs a matchup when the request opts in (body `arena: true` or header
# `x-arena: on`).
ARENA_TRIGGER=always

# Model streamed for single (non-engaged) responses: an enabled models row
# identified by UUID, provider_model_id slug, display_name, or
# provider:provider_model_id. Resolved to a UUID at boot. Required when
# ARENA_TRIGGER is not `always`.
ARENA_DEFAULT_MODEL=

# --- Slot join ---------------------------------------------------------------

# Serving one matchup over two sibling requests, for chat UIs whose compare view
# fans a multi-model turn into one request per model. Opt-in per request (a
# `joinKey` in the body); these only tune it.

# Rendezvous window in ms: how long the first sibling waits for its pair before
# falling back to streaming both slots itself. `0` disables joining entirely and
# a `joinKey` is then ignored. Range 0-60000; the server refuses to boot outside
# it.
ARENA_JOIN_WINDOW_MS=2000

# Cap on unpaired join scopes held in memory. Over the cap a join is refused
# (`503 join_unavailable`) rather than queued. Range 1-100000.
ARENA_JOIN_MAX_PENDING=256

# Per-connection event backlog once a matchup is joined: events that may queue for
# one slot whose client reads slower than the model produces. Over the cap that one
# connection fails rather than growing without bound. Range 16-1000000.
ARENA_JOIN_MAX_QUEUED_EVENTS=4096

# --- Rating worker (worker/) -------------------------------------------------

# Seconds between periodic refits.
REFIT_INTERVAL_SECONDS=300
# Refits between from-scratch (cold) ground-truth fits in loop mode; the refits
# in between are warm-started from the previous solution. 0 warm-starts forever.
# At the default interval, 12 means an hourly full recompute.
FULL_REFIT_EVERY=12
# Ridge-prior strength for the main fit (log-odds scale; weak by default).
RATING_RIDGE=0.01
# Ridge-prior strength for the style-controlled fit (optional via --style on
# the CLI; on by default in the Docker image).
STYLE_RIDGE=0.05

# Worker logging. LOG_LEVEL: DEBUG|INFO|WARNING|ERROR. LOG_FORMAT: text|json.
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Model providers ---------------------------------------------------------

# Register the deterministic `mock` provider (`1` or `true`), which answers
# without any LLM key — demos, the examples, and the e2e suite run on it. Off by
# default so it never shadows a real provider; pair it with the mock lineup
# (`npm run db:seed:mock --workspace server`).
ARENA_MOCK_PROVIDER=

# Create a key at https://aistudio.google.com/apikey (the default seed lineup is
# Gemini models, so this is needed out of the box).
GOOGLE_API_KEY=

# OpenAI, or an OpenAI-compatible endpoint when OPENAI_BASE_URL is set. The
# provider registers when either variable is present (base URL defaults to
# https://api.openai.com/v1).
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local providers. Ollama is registered at this default even when omitted.
OLLAMA_BASE_URL=http://localhost:11434
# vLLM registers only when a base URL is set; the API key is optional.
VLLM_BASE_URL=
VLLM_API_KEY=

# Optional host-owned OpenAI-compatible proxy (provider key stays in the host).
HOST_PROXY_URL=
HOST_PROXY_TOKEN=

# --- Advanced ----------------------------------------------------------------

# Override the directory of the built web bundle the server serves. Defaults to
# ../../web/dist relative to the compiled server, which is correct for both the
# repo layout and the Docker image; only set this for non-standard deployments.
# WEB_DIST_DIR=
