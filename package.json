{
  "name": "omni-arena",
  "private": true,
  "workspaces": [
    "server",
    "packages/react-sdk",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "concurrently -n server,web \"npm run dev --workspace server\" \"npm run dev --workspace web\"",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
